{
  "__inputs": [{
    "name": "DS_PROMETHEUS",
    "label": "Prometheus",
    "type": "datasource",
    "pluginId": "prometheus",
    "pluginName": "Prometheus"
  }],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat",       "name": "Stat",       "version": "" },
    { "type": "panel", "id": "table",      "name": "Table",      "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series","version": "" }
  ],
  "description": "Vue Domaine — KPIs par équipe du domaine sélectionné. Cliquer sur une équipe pour le détail.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [{
    "icon": "arrow-left",
    "title": "← Retour Portail Direction",
    "type": "link",
    "url": "/d/kafka-n0-portail-direction?var-namespace=${namespace}&var-cluster=${cluster}",
    "targetBlank": false
  }],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["kafka", "metier", "domaine"],
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "N1 — Vue Domaine",
  "uid": "kafka-n1-vue-domaine",
  "version": 1,

  "templating": {
    "list": [
      {
        "current": { "value": "kafka-prod" },
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(kafka:domain:health_score, namespace)",
        "hide": 0,
        "label": "Environnement",
        "name": "namespace",
        "options": [],
        "query": "label_values(kafka:domain:health_score, namespace)",
        "refresh": 2, "sort": 1, "type": "query"
      },
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(kafka:domain:health_score{namespace=\"$namespace\"}, strimzi_io_cluster)",
        "hide": 0,
        "label": "Cluster",
        "name": "cluster",
        "options": [],
        "query": "label_values(kafka:domain:health_score{namespace=\"$namespace\"}, strimzi_io_cluster)",
        "refresh": 2, "sort": 1, "type": "query"
      },
      {
        "current": {},
        "datasource": "${DS_PROMETHEUS}",
        "definition": "label_values(kafka:domain:health_score{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\"}, consumer_domain)",
        "hide": 0,
        "label": "Domaine",
        "name": "domain",
        "options": [],
        "query": "label_values(kafka:domain:health_score{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\"}, consumer_domain)",
        "refresh": 2, "sort": 1, "type": "query"
      }
    ]
  },

  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "📊 Domaine $domain — KPIs",
      "type": "row"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Santé globale du domaine. 100=OK / 0=PROBLÈME",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0":   { "color": "red",   "text": "🔴 PROBLÈME" } }, "type": "value" },
            { "options": { "100": { "color": "green",  "text": "✅ OK"       } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red",   "value": null },
            { "color": "green", "value": 100  }
          ]},
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "kafka:domain:health_score{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
        "refId": "A"
      }],
      "title": "Santé du Domaine",
      "type": "stat"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Topics actifs dans le domaine",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "kafka:domain:topics:actifs{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", domain=\"$domain\"}",
        "refId": "A"
      }],
      "title": "Topics Actifs",
      "type": "stat"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Messages produits par seconde dans le domaine",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "mps"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "kafka:domain:messages_produits:rate5m{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", domain=\"$domain\"}",
        "refId": "A"
      }],
      "title": "Messages Produits/s",
      "type": "stat"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Messages consommés par seconde dans le domaine",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "mps"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "kafka:domain:messages_consommes:rate5m{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
        "refId": "A"
      }],
      "title": "Messages Consommés/s",
      "type": "stat"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Lag total de consommation dans le domaine",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [{ "options": { "0": { "color": "green", "text": "0" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null   },
            { "color": "orange", "value": 1      },
            { "color": "red",    "value": 100000 }
          ]},
          "unit": "short"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "kafka:domain:consommateur:lag:total{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
        "refId": "A"
      }],
      "title": "Lag Total Domaine",
      "type": "stat"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Messages en erreur dans les DLQ du domaine",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [{ "options": { "0": { "color": "green", "text": "Aucune erreur" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red",   "value": 1    }
          ]},
          "unit": "mps"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 7,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "kafka:domain:dlq:rate5m{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", domain=\"$domain\"}",
        "refId": "A"
      }],
      "title": "🚨 DLQ Domaine",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "title": "👥 Équipes du Domaine — Cliquer pour le détail",
      "type": "row"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Vue par équipe du domaine. Cliquer sur une équipe pour voir ses topics, consumer groups et lag.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "consumer_team" },
            "properties": [
              { "id": "displayName", "value": "Équipe" },
              { "id": "custom.width", "value": 200 },
              { "id": "links", "value": [{
                "title": "Voir le détail de l'équipe",
                "url": "/d/kafka-n2-vue-equipe?var-namespace=${__data.fields.namespace}&var-cluster=${__data.fields.strimzi_io_cluster}&var-domain=${__data.fields.consumer_domain}&var-team=${__data.fields.consumer_team}&${__url_time_range}",
                "targetBlank": false
              }]}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #topics" },
            "properties": [{ "id": "displayName", "value": "Topics Actifs" }, { "id": "custom.width", "value": 120 }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #produits" },
            "properties": [{ "id": "displayName", "value": "Produits/s" }, { "id": "unit", "value": "mps" }, { "id": "custom.width", "value": 130 }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #consommes" },
            "properties": [{ "id": "displayName", "value": "Consommés/s" }, { "id": "unit", "value": "mps" }, { "id": "custom.width", "value": 130 }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #lag" },
            "properties": [
              { "id": "displayName", "value": "Lag Total" },
              { "id": "custom.width", "value": 120 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green",  "value": null   },
                { "color": "orange", "value": 1      },
                { "color": "red",    "value": 100000 }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #cg_actifs" },
            "properties": [{ "id": "displayName", "value": "CG Actifs" }, { "id": "custom.width", "value": 100 }]
          },
          {
            "matcher": { "id": "byName", "options": "Value #cg_morts" },
            "properties": [
              { "id": "displayName", "value": "CG Morts" },
              { "id": "custom.width", "value": 100 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "red",   "value": 1    }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #cg_geles" },
            "properties": [
              { "id": "displayName", "value": "CG Gelés" },
              { "id": "custom.width", "value": 100 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "red",   "value": 1    }
              ]}}
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value #dlq" },
            "properties": [
              { "id": "displayName", "value": "DLQ msg/s" },
              { "id": "unit", "value": "mps" },
              { "id": "custom.width", "value": 120 },
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "red",   "value": 1    }
              ]}}
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "id": 11,
      "options": { "sortBy": [{ "displayName": "Lag Total", "desc": true }] },
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:topics:actifs{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", domain=\"$domain\"}",
          "refId": "topics", "instant": true, "format": "table"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:messages_produits:rate5m{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", domain=\"$domain\"}",
          "refId": "produits", "instant": true, "format": "table"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:messages_consommes:rate5m{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
          "refId": "consommes", "instant": true, "format": "table"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:consommateur:lag:total{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
          "refId": "lag", "instant": true, "format": "table"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:consommateur:cg:actifs{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
          "refId": "cg_actifs", "instant": true, "format": "table"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:consommateur:cg:morts{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
          "refId": "cg_morts", "instant": true, "format": "table"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:consommateur:cg:geles{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
          "refId": "cg_geles", "instant": true, "format": "table"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:dlq:rate5m{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", domain=\"$domain\"}",
          "refId": "dlq", "instant": true, "format": "table"
        }
      ],
      "title": "Tableau des Équipes — Domaine $domain",
      "type": "table",
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true } } }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 20,
      "title": "📈 Évolution — Domaine $domain",
      "type": "row"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Évolution messages produits et consommés par équipe",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "mps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 17 },
      "id": 21,
      "targets": [
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:messages_produits:rate5m{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", domain=\"$domain\"}",
          "legendFormat": "Produits — {{team}}",
          "refId": "A"
        },
        {
          "datasource": "${DS_PROMETHEUS}",
          "expr": "kafka:team:messages_consommes:rate5m{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
          "legendFormat": "Consommés — {{consumer_team}}",
          "refId": "B"
        }
      ],
      "title": "Messages Produits & Consommés/s par Équipe",
      "type": "timeseries"
    },

    {
      "datasource": "${DS_PROMETHEUS}",
      "description": "Évolution du lag par équipe dans le temps",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green",  "value": null   },
            { "color": "orange", "value": 1      },
            { "color": "red",    "value": 100000 }
          ]}
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 17 },
      "id": 22,
      "targets": [{
        "datasource": "${DS_PROMETHEUS}",
        "expr": "kafka:team:consommateur:lag:total{namespace=\"$namespace\", strimzi_io_cluster=\"$cluster\", consumer_domain=\"$domain\"}",
        "legendFormat": "Lag — {{consumer_team}}",
        "refId": "A"
      }],
      "title": "Lag par Équipe",
      "type": "timeseries"
    }
  ]
}
